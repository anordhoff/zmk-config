#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>

/ {
  keymap {
    compatible = "zmk,keymap";

    default_layer {
/*
 *     ------------------------------------------------------------------                             -----------------------------------------------------------------
 *    |    TAB    |    Q     |    W     |    F     |    P     |    B     |                           |    J     |    L     |    U     |    Y     |    ;     |    '     |
 *    |    BSPC   |    A     |    R     |    S     |    T     |    G     |----------       ----------|    M     |    N     |    E     |    I     |    O     |   ENTER  |
 *    |    XXX    |    Z     |    X     |    C     |    D     |    V     |   XXX    |     |   XXX    |    K     |    H     |    ,     |    .     |    /     |   XXX    |
 *     ---------------------------------|  BT_CLR  |  SPACE   | BT_CLALL |   XXX    |     |   XXX    |  BT_NXT  |  SHIFT   |  BT_PRV  |--------------------------------
 *                                       -------------------------------------------       -------------------------------------------
 */
      bindings = <
        &kp TAB    &kp Q      &kp W      &kp F      &kp P      &kp B                                  &kp J      &kp L      &kp U      &kp Y      &kp SEMI   &kp SQT
        &kp BSPC   &kp A      &kp R      &kp S      &kp T      &kp G                                  &kp M      &kp N      &kp E      &kp I      &kp O      &kp ENTER
        &kp LCTRL  &kp Z      &kp X      &kp C      &kp D      &kp V          &none        &none      &kp K      &kp H      &kp COMMA  &kp DOT    &kp SLASH  &none
                                         &bt BT_CLR &kp SPACE  &bt BT_CLR_ALL &none        &none      &bt BT_NXT &kp RSHIFT &trans
      >;
    };
  };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/behaviors.h>

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

&lt {
    tapping-term-ms = <250>;
    flavor = "tap-preferred";
};

/ {
  behaviors {
    mt_esc: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            compatible = "zmk,behavior-hold-tap";
            flavor = "hold-preferred";
            tapping-term-ms = <170>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap-Escape";
    };

    lt_spc: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <170>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap-Space";
    };
  };
};

#define _COLEMAK     0
#define _COLEMAK_MEH 1
#define _SYMBOL      2
#define _NUMPAD      3
#define _NAVIGATION  4
#define _FUNCTION    5
#define _ADJUST      6

#define XXXXXXX &none
#define _______ &trans

// colemak layers
#define SYM     &mo _SYMBOL
#define NUM     &mo _NUMPAD
#define NAV     &mo _NAVIGATION
#define FUNC    &mo _FUNCTION
#define LHYPER  LGUI
#define RHYPER  RGUI

// additional layers
#define ADJUST  &mo _ADJUST

// layer mod taps
#define MT_SPACE &lt_spc SYMBOL SPACE
#define MT_ESC   &mt_esc RSHFT  ESC

// home row mods
#define MT_A     &lt _COLEMAK_MEH A
#define MT_R     &mt LGUI  R
#define MT_S     &mt LALT  S
#define MT_T     &mt LCTRL T
#define MT_N     &mt RCTRL N
#define MT_E     &mt RALT  E
#define MT_I     &mt RGUI  I
#define MT_O     &lt _COLEMAK_MEH O

#define MT_DLLR  &mt LGUI  DLLR
#define MT_PRCNT &mt LALT  PRCNT
#define MT_CARET &mt LCTRL CARET
#define MT_EQUAL &mt RCTRL EQUAL
#define MT_LBKT  &mt RALT  LBKT
#define MT_RBKT  &mt RGUI  RBKT
 
